{
  "name": "anyloc-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Anyloc Setup — installation iPhone via USB",
  "author": "Anyloc <contact@anyloc.io>",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis",
    "build": "electron-builder"
  },
  "build": {
    "appId": "io.anyloc.setup",
    "productName": "Anyloc Setup",
    "artifactName": "Anyloc-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": "-",
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
