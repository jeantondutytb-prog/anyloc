<?xml version="1.0" encoding="utf-8"?>
<!-- Profile page pieces, mirroring SettingsView on iOS. -->
<resources>
    <style name="Profile" />

    <style name="Profile.SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/light_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Profile.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card_light</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Profile.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Profile.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/light_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Profile.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Profile.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/light_border</item>
    </style>

    <style name="Profile.Icon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Profile.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_plan</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:textColorHint">@color/light_dim</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
