<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:endColor="#D9A855F7" android:startColor="#D9EC4899" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:endColor="@color/accent_end" android:startColor="@color/accent_start" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
